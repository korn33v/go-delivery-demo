{
  "uid": "godelivery-business",
  "title": "GoDelivery — Business",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "tags": [
    "GoDelivery"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
