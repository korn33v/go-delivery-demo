{
  "uid": "godelivery-technical",
  "title": "GoDelivery — Technical",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "tags": [
    "GoDelivery"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(http_server_requests_total, service)",
        "definition": "label_values(http_server_requests_total, service)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "route",
        "label": "Route",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(http_server_requests_total{service=~\"$service\"}, route)",
        "definition": "label_values(http_server_requests_total{service=~\"$service\"}, route)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "HTTP RPS по сервисам",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service)(rate(http_server_requests_total{service=~\"$service\",route=~\"$route\"}[2m]))",
          "legendFormat": "{{service}}",
          "format": "time_series",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "HTTP error rate (4xx + 5xx)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (service)(rate(http_server_requests_total{service=~\"$service\",route=~\"$route\",status=~\"4..|5..\"}[2m])) / clamp_min(sum by (service)(rate(http_server_requests_total{service=~\"$service\",route=~\"$route\"}[2m])),0.001)",
          "legendFormat": "{{service}}",
          "format": "time_series",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "HTTP latency p50 / p95 / p99",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5,sum by (le,service)(rate(http_server_request_duration_seconds_bucket{service=~\"$service\",route=~\"$route\"}[2m])))",
          "legendFormat": "{{service}} p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95,sum by (le,service)(rate(http_server_request_duration_seconds_bucket{service=~\"$service\",route=~\"$route\"}[2m])))",
          "legendFormat": "{{service}} p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99,sum by (le,service)(rate(http_server_request_duration_seconds_bucket{service=~\"$service\",route=~\"$route\"}[2m])))",
          "legendFormat": "{{service}} p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "Top slow endpoints (p95)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(5,histogram_quantile(0.95,sum by(le,service,route)(rate(http_server_request_duration_seconds_bucket{service=~\"$service\",route=~\"$route\"}[2m]))))",
          "legendFormat": "{{service}} {{route}}",
          "format": "time_series",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "title": "Handler errors / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(service,route)(rate(handler_errors_total{service=~\"$service\",route=~\"$route\"}[2m]))",
          "legendFormat": "{{service}} {{route}}",
          "format": "time_series",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "DB operation p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le,service,operation,table)(rate(db_operation_duration_seconds_bucket{service=~\"$service\"}[2m])))",
          "legendFormat": "{{service}} {{operation}} {{table}}",
          "format": "time_series",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "title": "Kafka produced / consumed / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(service,topic)(rate(kafka_messages_produced_total{service=~\"$service\"}[2m]))",
          "legendFormat": "produce {{service}} {{topic}}"
        },
        {
          "refId": "B",
          "expr": "sum by(service,topic)(rate(kafka_messages_consumed_total{service=~\"$service\"}[2m]))",
          "legendFormat": "consume {{service}} {{topic}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "title": "Kafka consumer errors / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(service,topic)(rate(kafka_consumer_errors_total{service=~\"$service\"}[2m]))",
          "legendFormat": "{{service}} {{topic}}",
          "format": "time_series",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "title": "HTTP requests по route/status",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(service,route,status)(http_server_requests_total{service=~\"$service\",route=~\"$route\"})",
          "legendFormat": "{{service}}",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    }
  ]
}